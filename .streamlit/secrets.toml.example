# Copy this file to .streamlit/secrets.toml. Never commit the real file.
# Generate each hash with: python -c "import hashlib; print(hashlib.sha256(b'your-long-code').hexdigest())"
VIEWER_CODE_SHA256 = "replace-with-64-character-sha256"
ADMIN_CODE_SHA256 = "replace-with-a-different-64-character-sha256"

# Optional: omit both values to use local ./data storage.
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_KEY = "server-side-storage-key"
