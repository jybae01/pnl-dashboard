{
	admin off
	local_certs
	persist_config off
}

phase-b.localhost:8443 {
	tls internal
	encode zstd gzip

	@bff path /api/* /health/*
	handle @bff {
		reverse_proxy bff-a:8000 bff-b:8000 {
			lb_policy round_robin
			health_uri /health/ready
			health_interval 5s
			health_timeout 3s
			lb_try_duration 5s
			transport http {
				dial_timeout 3s
				response_header_timeout 180s
			}
		}
	}

	handle {
		reverse_proxy frontend:8080
	}

	log {
		output stdout
		format json
	}
}
