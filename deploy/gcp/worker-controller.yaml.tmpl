apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: pnl-worker-controller
  labels:
    source-commit: __SOURCE_COMMIT__
    release-stage: __RELEASE_STAGE__
    business-gate: __BUSINESS_GATE__
  annotations:
    run.googleapis.com/ingress: all
spec:
  template:
    metadata:
      labels:
        source-commit: __SOURCE_COMMIT__
        release-stage: __RELEASE_STAGE__
        business-gate: __BUSINESS_GATE__
      annotations:
        autoscaling.knative.dev/minScale: "0"
        autoscaling.knative.dev/maxScale: "1"
        run.googleapis.com/execution-environment: gen2
        run.googleapis.com/secrets: "pnl-supabase-secret-key:projects/__PROJECT_NUMBER__/secrets/pnl-supabase-secret-key"
    spec:
      serviceAccountName: pnl-worker-controller@__PROJECT_ID__.iam.gserviceaccount.com
      containerConcurrency: 1
      timeoutSeconds: 60
      containers:
        - name: controller
          image: __RUNTIME_IMAGE__
          args: [uvicorn, forecast.worker_controller_server:create_worker_controller_from_environment, --factory, --host, 0.0.0.0, --port, "8080"]
          ports:
            - name: http1
              containerPort: 8080
          resources:
            limits:
              cpu: "1"
              memory: 512Mi
          env:
            - name: SUPABASE_URL
              value: __SUPABASE_URL__
            - name: SUPABASE_SECRET_KEY_FILE
              value: /var/run/pnl-secrets/supabase/supabase_secret_key
            - name: GOOGLE_CLOUD_PROJECT
              value: __PROJECT_ID__
            - name: GOOGLE_CLOUD_REGION
              value: __REGION__
            - name: PNL_WORKER_POOL_NAME
              value: pnl-worker
            - name: CONTROLLER_LOG_LEVEL
              value: INFO
          volumeMounts:
            - name: supabase-secret
              mountPath: /var/run/pnl-secrets/supabase
          startupProbe:
            httpGet:
              path: /health/live
              port: 8080
            periodSeconds: 5
            failureThreshold: 12
      volumes:
        - name: supabase-secret
          secret:
            secretName: pnl-supabase-secret-key
            items:
              - key: latest
                path: supabase_secret_key
