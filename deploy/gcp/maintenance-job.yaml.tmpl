apiVersion: run.googleapis.com/v1
kind: Job
metadata:
  name: pnl-maintenance
  labels:
    source-commit: __SOURCE_COMMIT__
    release-stage: __RELEASE_STAGE__
    business-gate: __BUSINESS_GATE__
spec:
  template:
    metadata:
      labels:
        source-commit: __SOURCE_COMMIT__
        release-stage: __RELEASE_STAGE__
        business-gate: __BUSINESS_GATE__
      annotations:
        run.googleapis.com/execution-environment: gen2
        run.googleapis.com/secrets: "pnl-supabase-secret-key:projects/__PROJECT_NUMBER__/secrets/pnl-supabase-secret-key"
    spec:
      taskCount: 1
      parallelism: 1
      template:
        spec:
          serviceAccountName: pnl-maintenance@__PROJECT_ID__.iam.gserviceaccount.com
          maxRetries: 0
          timeoutSeconds: "900"
          containers:
            - name: maintenance
              image: __RUNTIME_IMAGE__
              args:
                - python
                - -m
                - forecast.maintenance
                - cleanup
              resources:
                limits:
                  cpu: "1"
                  memory: 1Gi
              env:
                - name: PNL_REPOSITORY_BACKEND
                  value: supabase
                - name: SUPABASE_URL
                  value: __SUPABASE_URL__
                - name: SUPABASE_SECRET_KEY_FILE
                  value: /var/run/pnl-secrets/supabase/supabase_secret_key
                - name: BFF_TEMP_ROOT
                  value: /var/tmp/pnl
                - name: BFF_TEMP_QUOTA_BYTES
                  value: "536870912"
                - name: PNL_VOLUME_CANARY_PATHS
                  value: /var/tmp/pnl:/app/data
              volumeMounts:
                - name: maintenance-temp
                  mountPath: /var/tmp/pnl
                - name: model-cache
                  mountPath: /app/data
                - name: supabase-secret
                  mountPath: /var/run/pnl-secrets/supabase
          volumes:
            - name: maintenance-temp
              emptyDir:
                medium: Memory
                sizeLimit: 512Mi
            - name: model-cache
              emptyDir:
                medium: Memory
                sizeLimit: 256Mi
            - name: supabase-secret
              secret:
                secretName: pnl-supabase-secret-key
                items:
                  - key: latest
                    path: supabase_secret_key
